# =============================================================================
# YouTube Live Chat Alert Bot - 100% FREE All-in-One Configuration
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. ntfy.sh: Real-Time Alerts + Phone Remote Control (RECOMMENDED - 100% FREE)
# ─────────────────────────────────────────────────────────────────────────────
# Pick any unique topic name (no spaces).
# Step A: Install the "ntfy" app on your phone (Android / iOS) from App Store / Google Play.
# Step B: Open the app, tap "+", and subscribe to this exact topic name.
# Step C: Inside the topic, you will receive all live alerts.
# Step D: Type "init" in the topic anytime to trigger & start the bot!
NTFY_TOPIC=my-private-yt-alert-room-12345
# Optional: Set to a custom or self-hosted ntfy server (defaults to https://ntfy.sh)
NTFY_SERVER=https://ntfy.sh


# ─────────────────────────────────────────────────────────────────────────────
# 2. YouTube Monitoring Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Target channel ID (UC...), @handle, or full channel URL (e.g. @MrBeast)
YT_CHANNEL=@YourStreamerHandle

# Watched keywords (comma-separated). Leave empty to use defaults.
KEYWORDS=solo, 1v1, ff, free fire, custom room

# Optional YouTube Data API keys for fallback (comma-separated)
# The primary engine uses 0-Quota Native Innertube web protocol for free.
YOUTUBE_API_KEYS=

# How often to check for live stream while idle (in seconds, default: 180)
IDLE_CHECK_INTERVAL_SECONDS=180

# Anti-spam alert debounce cooldown in seconds (default: 30)
ALERT_COOLDOWN_SECONDS=30

# Anti-spam user duplicate message cooldown in seconds (default: 60)
USER_SPAM_COOLDOWN_SECONDS=60


# ─────────────────────────────────────────────────────────────────────────────
# 3. Optional: Telegram Bot Alerts & Controls (Alternative Free Option)
# ─────────────────────────────────────────────────────────────────────────────
# Leave empty if you are using ntfy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─────────────────────────────────────────────────────────────────────────────
# 4. Server & Cloud Execution Settings
# ─────────────────────────────────────────────────────────────────────────────
# If true, bot starts checking immediately on startup.
# If false, bot waits until you type "init" in your ntfy topic!
AUTO_START_BOT=false

# Server port (Render automatically sets this)
PORT=5000
HOST=0.0.0.0
